{
 "openapi": "3.1.0",
 "info": {
  "title": "Agent Data Co API",
  "version": "1.0.0",
  "description": "Structured, daily-refreshed data feeds on the AI ecosystem. Starter plan: $19/month, 10,000 requests/month.",
  "contact": {
   "email": "hello@agentdataco.com",
   "url": "https://agentdataco.com/docs"
  }
 },
 "servers": [
  {
   "url": "https://agentdataco.com"
  }
 ],
 "security": [
  {
   "bearerAuth": []
  }
 ],
 "paths": {
  "/api/v1/github-ai-repos": {
   "get": {
    "operationId": "github_ai_repos",
    "summary": "GitHub AI agent & MCP repos",
    "description": "Repos tagged mcp, mcp-server, ai-agent(s), llm-agent, agentic-ai, autonomous-agents: top by stars plus new in the last 30 days. Stars, forks, language, license, topics. `since` filters on `created_at`.",
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "parameters": [
     {
      "name": "limit",
      "in": "query",
      "schema": {
       "type": "integer",
       "default": 100,
       "minimum": 1,
       "maximum": 1000
      }
     },
     {
      "name": "offset",
      "in": "query",
      "schema": {
       "type": "integer",
       "default": 0
      }
     },
     {
      "name": "since",
      "in": "query",
      "description": "ISO 8601 date/time; only rows whose date field is on/after it",
      "schema": {
       "type": "string",
       "format": "date-time"
      }
     },
     {
      "name": "q",
      "in": "query",
      "description": "Case-insensitive substring match across all fields",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "repo",
      "in": "query",
      "description": "Exact owner/name. Untracked repos are queued for daily collection.",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Feed rows",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/FeedResponse"
        }
       }
      }
     },
     "401": {
      "description": "Missing/invalid/revoked key"
     },
     "429": {
      "description": "Monthly request limit reached"
     }
    }
   }
  },
