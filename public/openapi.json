  "/api/v1/sample": {
   "get": {
    "operationId": "sample",
    "summary": "Free sample (no key): 5 rows from each feed",
    "security": [],
    "parameters": [
     {
      "name": "name",
      "in": "query",
      "description": "Optional single feed name",
      "schema": {
       "type": "string",
       "enum": [
        "github-ai-repos",
        "show-hn-ai",
        "mcp-servers",
        "ai-pricing",
        "llm-pricing",
        "hf-trending"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Samples"
     }
    }
   }
  },
  "/api/v1/{feed}/history": {
   "get": {
    "operationId": "history",
    "summary": "Daily time series for one entity (Starter: last 30 days; Pro: full archive). Max 90-day window, paginated.",
    "parameters": [
     {
      "name": "feed",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "enum": [
        "github-ai-repos",
        "show-hn-ai",
        "mcp-servers",
        "ai-pricing",
        "llm-pricing",
        "hf-trending"
       ]
      }
     },
     {
      "name": "entity",
      "in": "query",
      "required": true,
      "description": "github: owner/repo; show-hn: item id; mcp: server name; hf: model:<id>|space:<id>|dataset:<id>; llm: OpenRouter id; ai-pricing: page URL",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "from",
      "in": "query",
      "schema": {
       "type": "string",
       "format": "date"
      }
     },
     {
      "name": "to",
      "in": "query",
      "schema": {
       "type": "string",
       "format": "date"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 90,
       "default": 31
      }
     },
     {
      "name": "cursor",
      "in": "query",
      "description": "nextCursor from previous page",
      "schema": {
       "type": "string",
       "format": "date"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Rows {date, ...metrics, rank}"
     },
     "400": {
      "description": "Missing entity, bad dates, or window > 90 days"
     },
     "429": {
      "description": "Daily history/trends limit reached (code daily_history_limit) or key throttled for bulk-extraction velocity (code velocity_throttled); see Retry-After"
     }
    },
    "description": "Requires a specific entity; there is no whole-feed history endpoint. Max 90 days between from and to; page size `limit` 1-90 (default 31), follow `nextCursor`. Fair use: 200 (Starter) / 1,000 (Pro) history+trends calls per key per day; keys requesting many distinct entities/dates abnormally fast are throttled for 1 hour. Bulk/full-archive access requires a data licence (from $499/mo, hello@agentdataco.com)."
   }
  },
  "/api/v1/trends": {
   "get": {
    "operationId": "trends",
    "summary": "Top movers (1d/7d/30d) and change events (new entities, price changes, version bumps)",
    "parameters": [
     {
      "name": "window",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "1d",
        "7d",
        "30d"
       ]
      }
     },
     {
      "name": "feed",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "github-ai-repos",
        "show-hn-ai",
        "mcp-servers",
        "ai-pricing",
        "llm-pricing",
        "hf-trending"
       ]
      }
     },
     {
      "name": "date",
      "in": "query",
      "schema": {
       "type": "string",
       "format": "date"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Trends"
     },
     "429": {
      "description": "Daily history/trends limit reached (code daily_history_limit) or key throttled for bulk-extraction velocity (code velocity_throttled); see Retry-After"
     }
    },
    "description": "Latest trends by default. Past `date` requires `feed` and must be within your plan history. Counts toward the daily history/trends fair-use cap (200 Starter / 1,000 Pro)."
   }
  }
 },
 "components": {
  "securitySchemes": {
   "bearerAuth": {
    "type": "http",
    "scheme": "bearer"
   }
  },
  "schemas": {
   "FeedResponse": {
    "type": "object",
    "properties": {
     "feed": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "updatedAt": {
      "type": "string",
      "format": "date-time"
     },
     "total": {
      "type": "integer"
     },
     "offset": {
      "type": "integer"
     },
     "limit": {
      "type": "integer"
     },
     "count": {
      "type": "integer"
     },
     "data": {
      "type": "array",
      "items": {
       "type": "object"
      }
     }
    }
   }
  }
 }
